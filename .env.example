# ==============================================================
# Communauté Le Revenu — inventaire des variables d'environnement
# ==============================================================
# Ce fichier ne sert qu'à la documentation : rien ne le charge, ni application
# ni Docker. Strapi lit backend/.env, Next.js lit frontend/.env, et
# docker-compose.yml reçoit backend/.env par --env-file (voir le README).
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
# Les valeurs par défaut citées en commentaire vivent dans le code, pas ici.

# ===== BACKEND (Strapi) — backend/.env =====

# --- Serveur (config/server.ts) ---
# HOST : défaut 0.0.0.0, donc l'API est exposée sur le LAN, pas seulement en local.
# PORT : défaut 1337.
# APP_KEYS : liste séparée par des virgules.
HOST=
PORT=
APP_KEYS=

# --- Secrets (config/admin.ts et plugin users-permissions) ---
# JWT_SECRET signe le token d'accès des membres : le faire tourner invalide
# toutes les sessions utilisateurs.
# ADMIN_JWT_SECRET doit être présent, sinon le session manager échoue au boot.
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# SESSION_COOKIE_SECURE : marque ou non le cookie de refresh `secure`
# (config/plugins.ts). Vide, il suit NODE_ENV — donc vrai en production, et Koa
# refuse alors de l'émettre sur du HTTP en clair : la connexion répond 500.
# docker-compose.yml le force à false parce que la stack locale sert du HTTP.
# Derrière HTTPS, laisser vide ou mettre true.
SESSION_COOKIE_SECURE=

# --- Base de données — requis (config/database.ts) ---
# Requis pour démarrer sur Postgres et pour piloter docker-compose.yml, à la racine.
# Sans ces clés, config/database.ts retombe silencieusement sur SQLite
# (backend/.tmp/data.db) au lieu d'échouer : si le contenu « disparaît »,
# vérifier quel client a réellement démarré.
# DATABASE_CLIENT : défaut sqlite ; seuls postgres, mysql et sqlite sont acceptés.
# DATABASE_FILENAME : lu uniquement sur la branche sqlite, ignoré sinon.
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=
DATABASE_FILENAME=

# --- Base de données — optionnel (config/database.ts) ---
# DATABASE_URL : alternative aux clés discrètes ci-dessus (chaîne de connexion).
# DATABASE_SCHEMA : défaut public, branche postgres uniquement.
# Bornes du pool : défaut 2 à 10. Timeout d'acquisition : défaut 60000 ms.
# Les clés DATABASE_SSL_* n'ont d'effet que si DATABASE_SSL vaut true.
DATABASE_URL=
DATABASE_SCHEMA=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
DATABASE_CONNECTION_TIMEOUT=
DATABASE_SSL_KEY=
DATABASE_SSL_CERT=
DATABASE_SSL_CA=
DATABASE_SSL_CAPATH=
DATABASE_SSL_CIPHER=
DATABASE_SSL_REJECT_UNAUTHORIZED=

# --- Divers — optionnel ---
# WEBHOOKS_POPULATE_RELATIONS : config/server.ts, défaut false.
# FLAG_* : config/admin.ts, défaut true (bannières et mise en avant de l'offre payante).
WEBHOOKS_POPULATE_RELATIONS=
FLAG_NPS=
FLAG_PROMOTE_EE=
FLAG_DOC_LINKS=

# --- Tests — optionnel (tests/api.ts) ---
# La suite Vitest ne démarre aucun serveur : elle parle en HTTP à une instance
# que l'on a lancée soi-même (npm run dev puis npm run seed).
# TEST_API_URL : défaut http://localhost:1337.
# TEST_SEED_PASSWORD : mot de passe partagé des comptes de démo semés.
TEST_API_URL=
TEST_SEED_PASSWORD=

# ===== FRONTEND (Next.js) — frontend/.env =====

# NEXT_PUBLIC_STRAPI_URL : origine de l'API Strapi, SANS le suffixe /api.
# Valeur de repli http://localhost:1337 dans src/lib/strapi/config.ts.
# Attention : tout NEXT_PUBLIC_* est inliné dans le bundle navigateur AU BUILD,
# pas lu au démarrage — la changer impose de reconstruire l'image. Et aucun
# secret ne doit atterrir ici.
NEXT_PUBLIC_STRAPI_URL=

# STRAPI_INTERNAL_URL : origine lue par le seul rendu serveur, quand il ne peut
# pas joindre Strapi sur localhost. docker-compose.yml la fixe à
# http://backend:1337 ; vide hors Docker, config.ts retombe sur la clé publique.
STRAPI_INTERNAL_URL=

# ===== DOCKER (docker-compose.yml) — optionnel =====

# Ports publiés sur l'hôte. À l'intérieur des conteneurs les ports sont figés
# (postgres:5432, backend:1337, frontend:3000) : ces clés ne changent que ce que
# la machine voit. Défauts 1337 et 3000 ; côté base, c'est DATABASE_PORT.
# Elles se lisent par --env-file, donc depuis backend/.env.
BACKEND_PORT=
FRONTEND_PORT=
