# Origine de l'API Strapi, sans le suffixe /api.
# Valeur de repli dans src/lib/strapi/config.ts si la variable est absente.
# Attention : NEXT_PUBLIC_* est inlinée dans le bundle navigateur AU BUILD,
# pas lue au démarrage. La changer impose de reconstruire l'image.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Origine utilisée uniquement par le rendu serveur, quand il ne peut pas
# joindre Strapi sur localhost — c'est le cas en conteneur, où docker-compose.yml
# la fixe à http://backend:1337. Laisser vide hors Docker : config.ts retombe
# alors sur NEXT_PUBLIC_STRAPI_URL.
STRAPI_INTERNAL_URL=
