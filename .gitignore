# ==============================
# Project-wide .gitignore
# ==============================

# Dependencies
node_modules/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# ----- Next.js (frontend) -----
.next/
out/

# ----- Strapi (backend) -------
dist/
build/
.strapi/
.strapi-updater.json
.strapi-cloud.json
.tmp/
public/uploads/*
!public/uploads/.gitkeep
exports/
license.txt

# ----- PostgreSQL data ---------
pg_data/

# ----- OS / editor junk -------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# ----- Logs --------------------
*.log
npm-debug.log*
yarn-debug.log*

# ----- TypeScript build info ---
*.tsbuildinfo
next-env.d.ts

# ----- Misc --------------------
.vercel
coverage/
*.pem
.eslintcache

# Claude Code instruction files — kept local, not shared
CLAUDE.md
backend/CLAUDE.md
frontend/CLAUDE.md

maquette-communaute-le-revenu.html