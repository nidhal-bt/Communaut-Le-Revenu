# Base de données — requis pour démarrer sur Postgres et pour docker-compose.yml.
# Sans ces clés, config/database.ts retombe silencieusement sur SQLite (.tmp/data.db).
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=communaute_lerevenu
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
# Uniquement pour DATABASE_CLIENT=sqlite ; ignoré sinon.
DATABASE_FILENAME=
