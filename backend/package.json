{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "db:up": "docker compose --env-file .env -f ../docker-compose.yml up -d --wait postgres",
    "db:down": "docker compose --env-file .env -f ../docker-compose.yml down",
    "db:reset": "docker compose --env-file .env -f ../docker-compose.yml down -v",
    "db:config": "docker compose --env-file .env -f ../docker-compose.yml config",
    "seed": "tsx scripts/seed-data.ts",
    "dev": "npm run db:up && strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "test": "vitest run",
    "test:watch": "vitest",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@strapi/database": "5.60.0",
    "@strapi/plugin-cloud": "5.60.0",
    "@strapi/plugin-users-permissions": "5.60.0",
    "@strapi/strapi": "5.60.0",
    "pg": "8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "9f68ecd2-9532-4ddd-8c60-00581c6edf01",
    "installId": "71bedec21182e4824cc789e0c45adf06d280271e05971c6994895eb4ea3d00b4"
  }
}
